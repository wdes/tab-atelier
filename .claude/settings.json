{
  "permissions": {
    "allow": [
      "Bash(scripts/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-bash-background-guard.sh",
            "timeout": 10,
            "statusMessage": "foreground guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-lint-hook.sh",
            "timeout": 20,
            "statusMessage": "cargo fmt"
          }
        ]
      }
    ]
  }
}
