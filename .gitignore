/target

# LLVM coverage artifacts from local instrumented runs
*.profraw

# Scratch space for local-only tools (the fleet dashboard lives here).
# Deliberately untracked: it is a personal view, not part of the product.
/local/

# Agent handoff drops (tab-atelier handoff / the API upload endpoint write here).
# Working files for whoever is at the terminal — never part of the source.
inbox/
outbox/

# A local Bootstrap would shadow Debian's libjs-bootstrap5, which the server
# serves straight from /usr/share/javascript. Only put one here to pin a
# different build on purpose.
crates/tab-atelier-proxy/assets/vendor/bootstrap.min.css

# Web UI toolchain. TypeScript sources compile to the committed assets/*.js —
# see crates/tab-atelier-proxy/assets/README-typescript.md — so a package
# build never needs Node, and these never belong in the repo.
crates/tab-atelier-proxy/web/node_modules/

# Python bytecode. Derived from the scripts in scripts/ and regenerated on import.
# Four of them were committed by an `git add -A` in a commit about SPDX headers, which
# made every `python3 scripts/…` run dirty the tree — and a routine cleanup of that
# dirt deleted tracked files, because they looked like build output.
__pycache__/
*.py[cod]

# catbus-agent per-directory config, from docs/config-guide.md: a statement
# about the machine and the operator, not about the work.
.catbus/

# Signing keys must never be committed: this repository is public, and an APK
# signing key lets anyone sign a build that installs as an upgrade over the real
# app. The Android app's key lives in ~/.config/tab-atelier/ (and in the
# ANDROID_KEYSTORE_BASE64 CI secret), not in the tree.
*.keystore
*.jks

# The Android client moved to the android-app branch. Whatever remains here is
# local build output from the retired Slint client, including its signing key,
# which is exactly what the rule above is for.
/android/
