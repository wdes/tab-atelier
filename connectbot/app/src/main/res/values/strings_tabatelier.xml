<?xml version="1.0" encoding="utf-8"?>
<!--
	Strings this fork adds, kept in their own file rather than appended to
	upstream's values/strings.xml.

	A separate file means adding a string is a line here and nothing to reconcile
	when upstream edits its own strings — Android's resource merger combines every
	file under res/values/, so a resource does not care which file declares it. The
	same applies per locale: a translation goes in values-<locale>/strings_tabatelier.xml
	beside this file, which keeps upstream's own locale files untouched. See
	values-fr/ for an example.

	What CANNOT live here is replacing an upstream string. Two files in the same
	source set declaring the same name is a duplicate-resource error, not an
	override, so the few upstream strings we rewrite (app_name, app_desc,
	app_copyright and the help links) are edited in upstream's own strings.xml, in
	the commit that changes them.

	Prefer an upstream string to a new one wherever one fits. A string introduced
	here is English-only until someone translates it, while one upstream already
	has arrives in all of its locales — which is why the keys bar uses
	automation_key_function for its F-keys and console_menu_paste for its paste key
	rather than strings of its own.

	The `tabatelier_` and `hostpref_token*` prefixes exist to keep this file
	conflict-free: a name upstream later adds would otherwise collide and break
	the build.

	The `tabatelier_` and `hostpref_token*` prefixes exist to keep this file
	conflict-free: a name upstream later adds would otherwise collide and break
	the build.
-->
<resources>
	<!-- Host editor: a tab-atelier server is one URL — scheme, host, port and
	     any path prefix the daemon is mounted under — so it is entered as one,
	     rather than as a hostname and a port that cannot express either. -->
	<string name="tabatelier_url_title">Server URL</string>
	<string name="tabatelier_url_hint">https://host:8443</string>
	<string name="tabatelier_url_summary">The daemon\'s address, including http:// or https:// and any path prefix.</string>
	<string name="tabatelier_url_error">Enter a URL beginning with http:// or https://, for example https://host:8443</string>
	<!-- Shown under a server whose stored URL cannot be used, e.g. one from a
	     backup written by an older version of this app. -->
	<string name="tabatelier_url_invalid">This server\'s address is not a valid URL. Edit it and enter one, for example https://host:8443</string>

	<!-- Host editor: the tab-atelier server's API token. -->
	<string name="hostpref_token_title">API token</string>
	<string name="hostpref_token_unchanged">API token (unchanged)</string>
	<string name="hostpref_token_summary">Bearer token sent to the tab-atelier daemon.</string>
	<string name="hostpref_clear_token">Clear saved token</string>

	<!-- Host list: one tab-atelier server's tabs, below its row. -->
	<string name="tabatelier_refresh_tabs">Refresh tabs</string>
	<string name="tabatelier_tabs_loading">Loading tabs…</string>
	<string name="tabatelier_tabs_empty">No tabs</string>
	<string name="tabatelier_tabs_error">Could not reach this server: %1$s</string>
	<string name="tabatelier_tab_active">active</string>
	<string name="tabatelier_tab_locked">Locked</string>

	<!-- Shown when a tab is tapped before the terminal stage exists, so the tap
	     explains itself instead of looking like a failure. -->
	<string name="tabatelier_transport_not_yet">tab-atelier terminals arrive in a later stage.</string>

	<!-- Opening a tab's session. Each of these is a session that could not start
	     for a reason the user can act on, so they say what to do rather than
	     only what went wrong. -->
	<string name="tabatelier_url_missing">This server has no address yet. Open it in the host editor and enter its URL, for example https://host:8443</string>
	<string name="tabatelier_tab_not_chosen">No tab was chosen for this session. Open one from the host list.</string>

	<!-- The console title while a tab is open: the server's name, then the
	     tab's. A session is "which server" and "which of its tabs", and the tab
	     is the part that changes between them — two tabs of one server would
	     otherwise title themselves identically. Positional arguments, so a
	     translation can order them as its own language needs. -->
	<string name="tabatelier_console_title_with_tab">%1$s - %2$s</string>

	<!-- The terminal's special-keys bar, reworked for Tab Atelier Remote into a
	     two-row layout with a function-key page. Only the strings the app did not
	     already have are here; the rest of the bar's labels are upstream's. -->
	<string name="button_key_fn">FN</string>
	<!-- translatable="false" on purpose: a function key is F1 in every language, so
	     this is a notation rather than a string to translate — and saying so is also
	     what stops lint reporting the literal it replaces as hardcoded text.

	     Upstream has a string for the same thing (automation_key_function), and the
	     bar used it. Its French is machine-translated as "F %1$s", a space between the
	     letter and the number, which is wrong for a key label and is exactly what a
	     notation avoids by not being translated in the first place. -->
	<string name="button_key_function" translatable="false">F%1$s</string>
	<string name="image_description_function_keys">Show function keys</string>
	<string name="image_description_back_to_keys">Back to the keys</string>
</resources>
