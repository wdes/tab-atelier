#!/bin/sh
# SPDX-License-Identifier: MPL-2.0
# Service account for the proxy. It owns the account file and the host's Claude
# login, so it is a system user with no shell and no login.
set -e
case "$1" in
    configure)
        if ! getent passwd tab-atelier-proxy >/dev/null; then
            adduser --system --group --no-create-home \
                    --home /var/lib/tab-atelier-proxy \
                    --shell /usr/sbin/nologin \
                    --gecos "tab-atelier proxy" \
                    tab-atelier-proxy >/dev/null
        fi
        install -d -o tab-atelier-proxy -g tab-atelier-proxy -m 0700 /var/lib/tab-atelier-proxy
        # Enable on install, start it, and restart on an upgrade so the running
        # process is the new binary — but only while the operator has not
        # disabled the unit. `deb-systemd-helper was-enabled` is true for a
        # fresh install and false once someone runs `systemctl disable`, which
        # is how a disable survives every upgrade after it.
        #
        # The restart matters especially here: the UI is read from disk per
        # request, so a service left running the old binary would serve the NEW
        # html backed by the OLD binary — markup asking for fields the running
        # server does not know, rendering as nothing at all.
        if [ -d /run/systemd/system ] &&
           deb-systemd-helper --quiet was-enabled 'tab-atelier-proxy.service'; then
            deb-systemd-helper enable 'tab-atelier-proxy.service' >/dev/null || true
            deb-systemd-invoke restart 'tab-atelier-proxy.service' >/dev/null || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
