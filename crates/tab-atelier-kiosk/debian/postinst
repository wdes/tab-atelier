#!/bin/sh
# SPDX-License-Identifier: MPL-2.0
# Create the unprivileged service identity; its private state directory is
# managed separately below and systemd recreates it with the configured mode.
set -e
case "$1" in
    configure)
        if ! getent passwd tab-atelier-kiosk >/dev/null; then
            adduser --system --group --no-create-home \
                    --home /var/lib/tab-atelier-kiosk \
                    --shell /usr/sbin/nologin \
                    --gecos "tab-atelier kiosk" \
                    tab-atelier-kiosk >/dev/null
        fi
        install -d -o tab-atelier-kiosk -g tab-atelier-kiosk -m 0700 /var/lib/tab-atelier-kiosk
        # Enable on install, start it, and restart on an upgrade so the running
        # process is the new binary — but only while the operator has not
        # disabled the unit. `deb-systemd-helper was-enabled` is true for a
        # fresh install and false once someone runs `systemctl disable`, which
        # is how a disable survives every upgrade after it.
        if [ -d /run/systemd/system ] &&
           deb-systemd-helper --quiet was-enabled 'tab-atelier-kiosk.service'; then
            deb-systemd-helper enable 'tab-atelier-kiosk.service' >/dev/null || true
            deb-systemd-invoke restart 'tab-atelier-kiosk.service' >/dev/null || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
