#!/bin/sh
# SPDX-License-Identifier: MPL-2.0
#
# Every commit this repository produces carries the project's co-author
# trailer. Enforcing it here, rather than remembering it at each commit, is the
# point: a message written by hand, by a script, or by an agent all pass
# through `commit-msg`, and a missing trailer is a defect the hook fixes
# silently instead of one a reviewer has to catch.
#
# Idempotent, so `--amend` and repeated commits are no-ops.
#
# The identity is never defaulted. A wrong co-author is worse than a missing
# one, because it misattributes work and nothing downstream can tell. So the
# hook reads it from configuration and, finding none, refuses the commit with
# instructions rather than guessing:
#
#   git config coauthor.name  'Some Bot'
#   git config coauthor.email 'bot@example.com'
#
# Environment variables of the same meaning win over the config, for a one-off
# commit under a different identity.

msg_file=$1
[ -n "$msg_file" ] || exit 0
[ -f "$msg_file" ] || exit 0

name=${TA_COAUTHOR_NAME:-$(git config --get coauthor.name)}
email=${TA_COAUTHOR_EMAIL:-$(git config --get coauthor.email)}

if [ -z "$name" ] || [ -z "$email" ]; then
	cat >&2 <<-'EOF'
		commit-msg: no co-author identity configured.

		Set one, once, in this repository:

		  git config coauthor.name  'Some Bot'
		  git config coauthor.email 'bot@example.com'

		or export TA_COAUTHOR_NAME / TA_COAUTHOR_EMAIL for a single commit.
		There is deliberately no built-in default.
	EOF
	exit 1
fi

trailer="Co-authored-by: $name <$email>"

# Already there? Match the trailer as a whole line. Built from the same string
# as the append below, so the check and the write cannot drift apart.
if grep -qF "$trailer" "$msg_file"; then
	exit 0
fi

# Nothing but comment and blank lines: the commit is empty, and git will abort
# it on its own. Appending here would only turn it into "a commit whose sole
# content is the trailer", which is worse than the empty commit.
if ! grep -qvE '^[[:space:]]*(#|$)' "$msg_file"; then
	exit 0
fi

# Trailers belong in the final paragraph, blank-line separated, so append at
# the end of the file. In `--edit` mode git strips the comment lines that may
# follow; in `-m` mode there are none to begin with.
printf '\n%s\n' "$trailer" >>"$msg_file"
exit 0
