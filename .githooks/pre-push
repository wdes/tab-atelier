#!/bin/sh
# SPDX-License-Identifier: MPL-2.0
#
# Review everything since the last push, before it leaves the machine.
#
# See scripts/commit-review.sh: a deterministic scan, then a sub-agent reading the
# added lines. Both must pass.
#
# There is no bypass here. `git push --no-verify` skips this hook entirely — which
# is why the same script runs in CI over the pushed range, so a skipped hook is
# caught after the fact rather than trusted.
#
# Arguments are git's: <remote-name> <remote-url>, then "<local-ref> <local-sha>
# <remote-ref> <remote-sha>" per ref being pushed. The remote sha is the base: what
# is already published. A zero sha means the ref is new, so everything is reviewed.

set -u

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -x "$root/scripts/commit-review.sh" ] || exit 0

remote=${1:-origin}
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
	[ -n "${local_sha:-}" ] || continue
	# A delete has nothing to review.
	case $local_sha in 0000000000000000000000000000000000000000) continue ;; esac

	case $remote_sha in
	'' | 0000000000000000000000000000000000000000)
		# New ref: everything reachable from it is unpublished. Review the last
		# 20 commits rather than the whole history, which for a fork would be
		# unbounded and is not what is being pushed for the first time here.
		base="$local_sha~20"
		git rev-parse --verify "$base" >/dev/null 2>&1 || base=$(git rev-list --max-parents=0 "$local_sha" | head -1)
		;;
	*) base=$remote_sha ;;
	esac

	echo "review: $local_ref — commits since $base" >&2
	if ! "$root/scripts/commit-review.sh" "$base"; then
		status=1
	fi
done

exit $status
