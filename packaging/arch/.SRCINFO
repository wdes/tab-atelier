pkgbase = tab-atelier
	pkgdesc = Guake-style drop-down terminal emulator (alacritty_terminal + gpui)
	pkgver = 0.5.0
	pkgrel = 1
	url = https://github.com/wdes/tab-atelier
	arch = x86_64
	license = MPL-2.0
	makedepends = cargo
	makedepends = freetype2
	makedepends = fontconfig
	makedepends = libxcb
	makedepends = libxkbcommon
	makedepends = libxkbcommon-x11
	options = !lto
	source = tab-atelier-0.5.0.tar.gz::https://github.com/wdes/tab-atelier/archive/refs/tags/v0.5.0.tar.gz
	sha256sums = SKIP

pkgname = tab-atelier
	pkgdesc = Guake-style drop-down terminal emulator for Linux/X11 (desktop GUI)
	depends = gcc-libs
	depends = freetype2
	depends = fontconfig
	depends = libxcb
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = ttf-dejavu
	optdepends = noto-fonts-emoji: colour emoji in the UI (menus, status markers)
	conflicts = tab-atelier-headless
	backup = etc/tab-atelier/preferences.json
	backup = etc/claude-code/managed-settings.json

pkgname = tab-atelier-headless
	pkgdesc = Display-less tab-atelier daemon: same HTTP/TLS API, no X11/gpui
	install = tab-atelier-headless.install
	depends = gcc-libs
	depends = nftables
	depends = bubblewrap
	depends = systemd
	conflicts = tab-atelier
	backup = etc/tab-atelier/preferences.json
	backup = etc/claude-code/managed-settings.json
