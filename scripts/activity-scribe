#!/usr/bin/env node
// activity-scribe — deterministic aggregator for the "Dernières heures" dashboard
// panel (docs/dashboard-increment-5.md, S3). Reads recent agent transcripts +
// orchestrator-repo commits + the aligator swamp log, and writes a single
// `$ACTIVITY_STATE_DIR/activity.json` that the Rust route /dashboard/activity (S2)
// serves and the panel (S4) renders. Pure aggregation, no network, no writes
// outside ACTIVITY_STATE_DIR. Self-check: scripts/activity-scribe.test.mjs.
//
// Env contract (all overridable so it stays testable AND the feature whitelist
// stays DYNAMIC — never a hardcoded repo list):
//   ACTIVITY_PROJECTS_DIR  dir of *.jsonl transcripts (walked recursively)
//   ACTIVITY_STATE_DIR     holds swamp.jsonl (if any) + where activity.json lands
//   ACTIVITY_ORCH_REPOS    comma-separated repo PATHS = explicit orchestrator whitelist
//   ACTIVITY_TABS_JSON     path to `tab-atelier tabs --json` output; the scribe
//                          derives the whitelist from tabs whose role is
//                          `orchestrator`, resolving each to its PROJECT exactly
//                          like the dashboard (`<project>:` assignment override >
//                          basename of cwd) and scanning `<DEV_ROOT>/<project>`.
//                          Unioned with ACTIVITY_ORCH_REPOS. (prod path)
//   ACTIVITY_DEV_ROOT      repos root for the tabs->project resolution (default ~/Dev)
//   ACTIVITY_NOW           ISO-8601 "now" override (deterministic durations)
//   ACTIVITY_WINDOW_HOURS  aggregation window in hours (default 24)

"use strict";
const fs = require("node:fs");
const path = require("node:path");
const { execFileSync } = require("node:child_process");

const env = process.env;
const projectsDir = env.ACTIVITY_PROJECTS_DIR || "";
const stateDir = env.ACTIVITY_STATE_DIR || "";
const windowHours = Number(env.ACTIVITY_WINDOW_HOURS || 24);
const now = env.ACTIVITY_NOW ? new Date(env.ACTIVITY_NOW) : new Date();
const nowMs = now.getTime();
const windowStartMs = nowMs - windowHours * 3600 * 1000;
const inWindow = (ms) => ms >= windowStartMs && ms <= nowMs;
const dayOf = (ms) => new Date(ms).toISOString().slice(0, 10); // UTC calendar day

// 3-layer human-vs-injected classification (S7) — THE guard on the PO's key
// figure (autonomy = time without HUMAN intervention). A record is a HUMAN prompt
// iff its source is human AND its content is human:
//   source: `typed` OR `queued` count (a queued prompt is a human one the harness
//           buffered while busy); every other source — `system`, absent (tool_result
//           echoes / hook injections) — is INJECTED.
//   content: a plain string that is neither a keyboard nudge (aligator keepalives
//           like "continue"/"retry") nor a dispatched cron/round broadcast.
const HUMAN_SOURCES = new Set(["typed", "queued"]);
// Bare keepalive nudges (exact match, trimmed/lowercased) — an agent or the
// aligator re-typing these to advance a stuck tab is NOT a human decision. Kept
// to unambiguous single-gesture words so real instructions ("ok, go merge",
// "continue please") are untouched.
const NUDGES = new Set([
  "continue", "retry", "re", "done", "go", "next", "suite", "encore",
  "enchaine", "enchaîne", "poursuis", "fais ta passe", "vas-y", "vasy",
]);
const CRON_TICK = /^\s*(ronde\b|watcher\s+restart|restart\s+mx\s+imminent|r[ée]veil\s+(du\s+sage|des)\b|maintien\b|refresh\s+(orchestr|roster))/i;

function isHumanPrompt(rec) {
  if (rec.type !== "user" || !HUMAN_SOURCES.has(rec.promptSource)) return false;
  const content = rec.message && rec.message.content;
  if (typeof content !== "string") return false;                 // tool_result arrays
  const norm = content.trim().toLowerCase().replace(/[\s.!…]+$/, "");
  if (NUDGES.has(norm)) return false;                            // keepalive nudge
  if (CRON_TICK.test(content)) return false;                     // cron/round broadcast
  return true;
}

// Names of generic work roots that are NOT a project (mirror of Rust
// WORK_ROOT_NAMES in src/api.rs) — a cwd basename of one of these is not a repo.
const WORK_ROOT_NAMES = new Set(["dev", "src", "code", "projects", "repos", "workspace"]);

// Parse an assignment `[<project>:]<phase>/<role>` exactly like the dashboard's
// parse_assignment (src/api.rs:464): the `:` override is only honoured when it
// sits before the first `/`.
function parseAssignment(a) {
  if (!a) return { over: null, phase: "", role: "" };
  const headEnd = a.indexOf("/") < 0 ? a.length : a.indexOf("/");
  let over = null, rest = a;
  const colon = a.slice(0, headEnd).indexOf(":");
  if (colon >= 0) { over = a.slice(0, colon).trim(); rest = a.slice(colon + 1); }
  const parts = rest.split("/");
  return { over: over || null, phase: (parts[0] || "").trim(), role: (parts[1] || "").trim() };
}

// Resolve a tab's project like the dashboard's project_of (src/api.rs:568):
// override `<project>:` > basename of a repo cwd. Returns null for an itinerant
// méta cwd (a generic work root) — nothing to scan there.
function projectOf(cwd, assignment) {
  const { over } = parseAssignment(assignment);
  if (over) return over;
  if (cwd) {
    const base = cwd.replace(/\/+$/, "").split("/").pop() || "";
    if (base && !WORK_ROOT_NAMES.has(base.toLowerCase())) return base;
  }
  return null;
}

// --- 1. transcripts: tokens + human prompts --------------------------------
function walkJsonl(dir, out) {
  let entries;
  try { entries = fs.readdirSync(dir, { withFileTypes: true }); }
  catch { return; }
  for (const e of entries) {
    const p = path.join(dir, e.name);
    if (e.isDirectory()) walkJsonl(p, out);
    else if (e.isFile() && e.name.endsWith(".jsonl")) out.push(p);
  }
}

const tokens = { input: 0, output: 0, cache_creation: 0, cache_read: 0 };
const humanPromptMs = []; // ms timestamps of typed human prompts, in window

const files = [];
if (projectsDir) walkJsonl(projectsDir, files);
files.sort();
for (const file of files) {
  const lines = fs.readFileSync(file, "utf8").split("\n");
  for (const line of lines) {
    if (!line.trim()) continue;
    let rec;
    try { rec = JSON.parse(line); } catch { continue; }
    const ms = rec.timestamp ? Date.parse(rec.timestamp) : NaN;
    if (Number.isNaN(ms) || !inWindow(ms)) continue;
    if (rec.type === "assistant") {
      const u = (rec.message && rec.message.usage) || {};
      tokens.input += u.input_tokens || 0;
      tokens.output += u.output_tokens || 0;
      tokens.cache_creation += u.cache_creation_input_tokens || 0;
      tokens.cache_read += u.cache_read_input_tokens || 0;
    } else if (isHumanPrompt(rec)) {
      humanPromptMs.push(ms);
    }
  }
}

// --- 2. features: `feat(` commits in-window from the orchestrator whitelist --
// The whitelist is explicit paths (ACTIVITY_ORCH_REPOS) UNIONED with repos
// resolved from live orchestrator tabs (ACTIVITY_TABS_JSON). Resolving each tab
// to its PROJECT (override > basename cwd) — not its raw cwd — is what lets an
// orchestrator whose cwd is a work root but whose assignment overrides to
// `tab-atelier:...` still credit tab-atelier's feat( commits (where the harness
// itself lives). Without this the overridden repo's features stay stuck at 0.
const repoSet = new Set((env.ACTIVITY_ORCH_REPOS || "").split(",").map((s) => s.trim()).filter(Boolean));
if (env.ACTIVITY_TABS_JSON) {
  const devRoot = env.ACTIVITY_DEV_ROOT || path.join(env.HOME || "", "Dev");
  try {
    const tabs = JSON.parse(fs.readFileSync(env.ACTIVITY_TABS_JSON, "utf8"));
    for (const tab of Array.isArray(tabs) ? tabs : []) {
      if (parseAssignment(tab.assignment).role !== "orchestrator") continue;
      const proj = projectOf(tab.cwd, tab.assignment);
      if (proj) repoSet.add(path.join(devRoot, proj));
    }
  } catch { /* no/malformed tabs json -> rely on explicit ACTIVITY_ORCH_REPOS */ }
}
const orchRepos = [...repoSet];

// SEPARATE deliverable counters over the SAME whitelist (S5) — features is NOT
// divided; fixes and self_tooling are counted on their own axes. features/fixes
// classify by the conventional-commit subject prefix; self_tooling is FILE-based
// (a commit that ADDS a script/tooling file), so a `chore(tooling)` that adds
// `scripts/…` counts as self-tooling without inflating features/fixes.
const TOOLING_PATH = /^(scripts|\.claude|tools?)\//;
const featMsByDay = {}; // day -> feat( count
let featuresImplemented = 0, fixes = 0, selfTooling = 0;
for (const repo of orchRepos) {
  let raw;
  try {
    raw = execFileSync(
      // \x1e (record sep) marks a commit header line; --name-status then lists
      // A/M/D<TAB>path lines for that commit until the next marker. --root so a
      // repo's first commit's adds are seen too. (NUL can't be passed to execFile.)
      "git", ["-C", repo, "log", "--no-merges", "--root", "--name-status",
        "--pretty=format:\x1e%aI\x1f%s"],
      { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }
    );
  } catch { continue; } // not a repo / no commits -> contributes nothing
  let inWin = false, subject = "", addedTooling = false;
  const flush = () => {
    if (!inWin) return;
    if (subject.startsWith("feat(")) featuresImplemented++;
    else if (subject.startsWith("fix(")) fixes++;
    if (addedTooling) selfTooling++;
  };
  for (const line of raw.split("\n")) {
    if (line.startsWith("\x1e")) {
      flush(); // close the previous commit
      const rest = line.slice(1);
      const sep = rest.indexOf("\x1f");
      const ms = Date.parse(rest.slice(0, sep));
      subject = rest.slice(sep + 1);
      inWin = !Number.isNaN(ms) && inWindow(ms);
      addedTooling = false;
      if (inWin && subject.startsWith("feat(")) {
        const d = dayOf(ms);
        featMsByDay[d] = (featMsByDay[d] || 0) + 1;
      }
    } else if (inWin && line) {
      const m = line.match(/^A\t(.+)$/); // added file
      if (m && TOOLING_PATH.test(m[1])) addedTooling = true;
    }
  }
  flush(); // close the last commit
}

// --- 3. aligator: swamp.jsonl line count (absent -> 0) ----------------------
let aligatorCalls = 0;
if (stateDir) {
  try {
    const swamp = fs.readFileSync(path.join(stateDir, "swamp.jsonl"), "utf8");
    aligatorCalls = swamp.split("\n").filter((l) => l.trim()).length;
  } catch { aligatorCalls = 0; }
}

// --- 4. derived totals ------------------------------------------------------
const humanPrompts = humanPromptMs.length;
const lastHumanMs = humanPrompts ? Math.max(...humanPromptMs) : null;
const minutesSinceLastHumanPrompt =
  lastHumanMs === null ? null : Math.round((nowMs - lastHumanMs) / 60000);
const tokensPerFeature = featuresImplemented
  ? Math.round((tokens.input + tokens.output) / featuresImplemented)
  : 0;

// --- 5. per-day: autonomy (longest inter-prompt gap) + features -------------
const promptsByDay = {}; // day -> [ms,...]
for (const ms of humanPromptMs) {
  const d = dayOf(ms);
  (promptsByDay[d] || (promptsByDay[d] = [])).push(ms);
}
const days = new Set([...Object.keys(promptsByDay), ...Object.keys(featMsByDay)]);
const perDay = [...days].sort().map((date) => {
  const times = (promptsByDay[date] || []).slice().sort((a, b) => a - b);
  let autonomy = 0;
  for (let i = 1; i < times.length; i++) {
    autonomy = Math.max(autonomy, Math.round((times[i] - times[i - 1]) / 60000));
  }
  return {
    date,
    autonomy_minutes_max: autonomy,
    features: featMsByDay[date] || 0,
  };
});

// --- 6. autonomy_record: all-time high-water of the daily autonomy gap --------
// The record only ever climbs, so read the previous activity.json's value as the
// floor (no side file — the scribe's own output IS the ledger). This makes the
// PO's "record" concrete: the longest the agents ever ran without a human.
const maxAutonomyThisRun = perDay.reduce((m, d) => Math.max(m, d.autonomy_minutes_max), 0);
let priorRecord = 0;
try {
  const prev = JSON.parse(fs.readFileSync(path.join(stateDir, "activity.json"), "utf8"));
  if (typeof prev?.totals?.autonomy_record === "number") priorRecord = prev.totals.autonomy_record;
} catch { /* first run / absent / malformed -> floor 0 */ }
const autonomyRecord = Math.max(priorRecord, maxAutonomyThisRun);

// --- 7. issues opened/closed — GitLab/GitHub counters, 0 when offline ---------
// ponytail: querying issue trackers per run is a network hop we don't take in the
// scribe (keeps it offline + deterministic). Emitted as numeric 0 for now; the
// upgrade path is a `glab issue list`/`gh` pass feeding these from the whitelist.
const issuesOpened = 0;
const issuesClosed = 0;

// --- 8. self_improvement_verdict — maturité (ships on stable tooling) vs -------
//        croissance (still building its own tooling). Deterministic classifier.
const totalDeliverables = featuresImplemented + fixes + selfTooling;
const toolingRate = totalDeliverables ? selfTooling / totalDeliverables : 0;
const autos = perDay.map((d) => d.autonomy_minutes_max);
const autonomyTrend = autos.length < 2
  ? "stable"
  : autos[autos.length - 1] > autos[0] ? "hausse"
  : autos[autos.length - 1] < autos[0] ? "baisse" : "stable";
let verdict = "indéterminé";
if (totalDeliverables > 0) verdict = toolingRate >= 0.25 ? "croissance" : "maturité";
const selfImprovementVerdict = {
  verdict,
  autonomy_trend: autonomyTrend,
  tooling_rate: Math.round(toolingRate * 100) / 100,
  evidence: [
    `${featuresImplemented} feat / ${fixes} fix / ${selfTooling} self-tooling sur ${windowHours}h`,
    `tooling_rate=${Math.round(toolingRate * 100)}% (seuil croissance 25%)`,
    `autonomie max ${maxAutonomyThisRun} min (record ${autonomyRecord} min, tendance ${autonomyTrend})`,
  ],
};

// --- 9. human-readable summary + PO benchmark --------------------------------
const summaryLines = [
  `${featuresImplemented} feature(s) livrée(s) sur ${windowHours}h`,
  `${tokensPerFeature} tokens / feature (entrée+sortie)`,
  `${humanPrompts} prompt(s) humain(s) — dernier il y a ${minutesSinceLastHumanPrompt ?? "?"} min`,
  `aligator: ${aligatorCalls} relance(s) autonome(s)`,
  `record autonomie: ${autonomyRecord} min — verdict ${verdict}`,
];

const activity = {
  generated_at: now.toISOString(),
  window_hours: windowHours,
  totals: {
    tokens_total: tokens,
    human_prompts: humanPrompts,
    minutes_since_last_human_prompt: minutesSinceLastHumanPrompt,
    features_implemented: featuresImplemented,
    fixes,
    self_tooling: selfTooling,
    issues_opened: issuesOpened,
    issues_closed: issuesClosed,
    tokens_per_feature: tokensPerFeature,
    aligator_calls: aligatorCalls,
    autonomy_record: autonomyRecord,
  },
  per_day: perDay,
  self_improvement_verdict: selfImprovementVerdict,
  // PO benchmark to display alongside the panel: a full /go-build run ≈ 6h.
  record: "go-build ~6h",
  summary_lines: summaryLines,
};

fs.mkdirSync(stateDir, { recursive: true });
fs.writeFileSync(
  path.join(stateDir, "activity.json"),
  JSON.stringify(activity, null, 2) + "\n"
);
